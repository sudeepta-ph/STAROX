# ── Backend API ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api

# ── Clerk ─────────────────────────────────────────────────────────────────────
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Firebase ──────────────────────────────────────────────────────────────────
# Backs Notifications (pages/Notifications.tsx), Projects (pages/Projects.tsx),
# the free-tier usage cap (lib/usageLimit.ts, components/UsageBar.tsx), and
# integration connector state (lib/integrations.ts). Create a project at
# https://console.firebase.google.com, enable Firestore, then copy the web
# app config from Project Settings → General → Your apps.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
