# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ── MongoDB ─────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/starox

# ── Cloudinary ──────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── DeepSeek (AI) ────────────────────────────────────────────────────────────────
# Model is pinned in code (services/ai/models.ts AI_MODEL) — no env override.
DEEPSEEK_API_KEY=sk-...your-deepseek-key...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Clerk ────────────────────────────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ── OpenRouter (AI models) ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...your-primary-key...
OPENROUTER_API_KEY_FALLBACK=sk-or-v1-...your-fallback-key...
OPENROUTER_API_KEY_STAROX1=sk-or-v1-...starox1-dedicated-key...
OPENROUTER_API_KEY_STAROX2=sk-or-v1-...starox2-dedicated-key...
OPENROUTER_API_KEY_STAROX3=sk-or-v1-...starox3-dedicated-key...

# ── USER BEHAVIOR: server-side fallback keys ────────────────────────────────────
# Optional — users can also supply their own keys via the UI.

# PostHog — Personal API Key: https://app.posthog.com/settings/user-api-keys
POSTHOG_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

# Mixpanel — Service Account: https://mixpanel.com/settings/project → Service Accounts
MIXPANEL_PROJECT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIXPANEL_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 — default property ID
GA4_PROPERTY_ID=properties/123456789

# ── USER VOICE: server-side fallback keys ───────────────────────────────────────

# Slack Bot Token — https://api.slack.com/apps → OAuth & Permissions
# Required scopes: channels:history, channels:read
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Discord Bot Token — https://discord.com/developers/applications
# Required permissions: Read Message History, View Channels
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_CHANNEL_ID=000000000000000000

# ── GitHub OAuth (PMX source import) ─────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_REDIRECT_URI below.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/pmx/github/callback

# ── Google OAuth (GA4 connector) ──────────────────────────────────────────────────
# Create an OAuth Client at https://console.cloud.google.com/apis/credentials
# Enable the "Google Analytics Admin API" and "Google Analytics Data API".
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/pmx/google/callback

# ── Notion OAuth ───────────────────────────────────────────────────────────────
# Create a public integration at https://www.notion.so/my-integrations
# Authorization callback URL must exactly match NOTION_REDIRECT_URI below.
NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_CLIENT_SECRET=your-notion-oauth-client-secret
NOTION_REDIRECT_URI=http://localhost:8080/api/pmx/notion/callback

# ── Slack OAuth (PMX connector) ──────────────────────────────────────────────────
# Distinct from SLACK_BOT_TOKEN/SLACK_CHANNEL_ID above (those are the
# /integrations/slack server-side fallback). These are the OAuth app
# credentials for the per-user /connectors → Slack connector.
# Create/use an app at https://api.slack.com/apps → Basic Information →
# App Credentials. Add the redirect URL below under OAuth & Permissions →
# Redirect URLs, exactly as it appears here.
SLACK_CLIENT_ID=your-slack-oauth-client-id
SLACK_CLIENT_SECRET=your-slack-oauth-client-secret
SLACK_REDIRECT_URI=http://localhost:8080/api/pmx/slack/callback

# ── Email (Resend) ───────────────────────────────────────────────────────────────
# Powers Frontend's ContactModal ("Book a demo"), blog publish notifications,
# and PMX workspace invites. Get an API key at https://resend.com/api-keys
# after verifying your sending domain at https://resend.com/domains.
RESEND_API_KEY=re_your_resend_api_key
SMTP_FROM_NAME=Starox
SMTP_FROM_EMAIL=noreply@starox.space
CONTACT_TO_EMAIL=hello@starox.space

# ── Token encryption ──────────────────────────────────────────────────────────
# 32-byte key, hex-encoded, used to encrypt OAuth tokens at rest. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=64-hex-char-key-generate-your-own-do-not-reuse-this

# ── Puppeteer (screenshot capture) ───────────────────────────────────────────────
# Optional. Overrides auto-detection in screenshot.ts's resolveChromiumPath(),
# which otherwise tries known Linux/macOS/Windows install paths, then PATH
# lookups, then falls back to @sparticuz/chromium's bundled Linux binary (only
# correct for a Linux production deploy). Particularly useful on Windows for
# local dev, where auto-detection may not find an installed browser — point
# this at your real Chrome/Edge, e.g.:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=
