# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ── Supabase ────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ── OpenRouter (AI models) ──────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...your-primary-key...
OPENROUTER_API_KEY_FALLBACK=sk-or-v1-...your-fallback-key...
OPENROUTER_API_KEY_STAROX1=sk-or-v1-...starox1-dedicated-key...
OPENROUTER_API_KEY_STAROX2=sk-or-v1-...starox2-dedicated-key...
OPENROUTER_API_KEY_STAROX3=sk-or-v1-...starox3-dedicated-key...

# ── USER BEHAVIOR: server-side fallback keys ────────────────────────────────────
# Optional — users can also supply their own keys via the UI.

# PostHog — Personal API Key: https://app.posthog.com/settings/user-api-keys
POSTHOG_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

# Mixpanel — Service Account: https://mixpanel.com/settings/project → Service Accounts
MIXPANEL_PROJECT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MIXPANEL_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 — default property ID
GA4_PROPERTY_ID=properties/123456789

# ── USER VOICE: server-side fallback keys ───────────────────────────────────────

# Slack Bot Token — https://api.slack.com/apps → OAuth & Permissions
# Required scopes: channels:history, channels:read
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Discord Bot Token — https://discord.com/developers/applications
# Required permissions: Read Message History, View Channels
DISCORD_BOT_TOKEN=your-discord-bot-token-here
DISCORD_CHANNEL_ID=000000000000000000
